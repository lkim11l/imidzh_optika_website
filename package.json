  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "nodemailer": "^10.2.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "clean-css": "^5.3.3"
  },
  "type": "module"
}
